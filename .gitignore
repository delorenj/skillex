# Generated source-command shims should not be committed as skill-set entries.
skill-sets/*/source-command-*
agents/hermes/pm/runtime/
.system/

# Secrets — .env is materialized from .env.op by `op inject` on mise enter,
# staged through a mktemp file and moved into place only on success.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op

# PJAN-82: generated skill projections are never tracked
# sync-skills.py, provision-packs.py and bmad-method rewrite these on every
# run. No trailing slash: some CLIs get a real directory here, some a symlink.
.claude/skills
.codex/skills
.gemini/skills
.copilot/skills
.opencode/skills
.kimi-code/skills
.crush/skills
.cursor/skills
.agents/skills
